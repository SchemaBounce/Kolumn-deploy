# Minimal Kolumn Project
# Single-file configuration demonstrating proper kolumn_data_objects pattern

# Provider configuration
provider "postgres" {
  host     = "localhost"
  port     = 5432
  database = "minimal_demo"
  username = "postgres"
  password = "password"
}

# ✅ CORRECT: Create data object FIRST for schema definition
create "kolumn_data_object" "user_schema" {
  name        = "Minimal User Schema"
  description = "Simple user schema for minimal project demonstration"

  columns = {
    id = {
      type            = "BIGINT"
      nullable        = false
      primary_key     = true
      classifications = [kolumn_classification.identifier]
    }

    name = {
      type            = "VARCHAR(100)"
      nullable        = false
      classifications = [kolumn_classification.public]
    }

    email = {
      type            = "VARCHAR(255)"
      nullable        = false
      unique          = true
      classifications = [kolumn_classification.pii]
    }

    created_at = {
      type            = "TIMESTAMP"
      nullable        = false
      default         = "CURRENT_TIMESTAMP"
      classifications = [kolumn_classification.public]
    }
  }

  metadata = {
    purpose = "minimal_demo"
    domain  = "user_management"
  }
}

# Classification definitions
create "kolumn_classification" "pii" {
  name        = "PII"
  description = "Personally Identifiable Information"
  requirements = {
    encryption   = true
    audit_access = true
  }
}

create "kolumn_classification" "public" {
  name        = "Public"
  description = "Public information"
  requirements = {
    encryption = false
  }
}

create "kolumn_classification" "identifier" {
  name        = "Identifier"
  description = "Unique identifiers and keys"
  requirements = {
    indexed = true
  }
}

# ✅ CORRECT: Table references data object directly
create "postgres_table" "users" {
  name = "users"
  columns = transform_columns(kolumn_data_object.user_schema.columns, {
    id         = { type = "SERIAL" }
    created_at = { default = "NOW()" }
  })
}

# Basic index using column from data object
create "postgres_index" "idx_users_email" {
  table   = postgres_table.users
  columns = ["email"]
  unique  = true
}
