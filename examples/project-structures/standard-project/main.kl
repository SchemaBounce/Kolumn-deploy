# Standard Project - Main Resource Configuration
# All resources are defined here using variables from variables.kl and kolumn_data_objects

# ✅ CORRECT: Create data objects FIRST for schema definition
create "kolumn_data_object" "user_schema" {
  name        = "Standard User Schema"
  description = "User schema for standard project structure"

  column "id" {
    type            = "BIGINT"
    nullable        = false
    primary_key     = true
    classifications = [kolumn_classification.identifier]
  }

  column "username" {
    type            = "VARCHAR(50)"
    nullable        = false
    unique          = true
    classifications = [kolumn_classification.public]
  }

  column "email" {
    type            = "VARCHAR(255)"
    nullable        = false
    unique          = true
    classifications = [kolumn_classification.pii]
  }

  column "password_hash" {
    type            = "VARCHAR(255)"
    nullable        = false
    classifications = [kolumn_classification.sensitive]
  }

  column "created_at" {
    type            = "TIMESTAMP"
    nullable        = false
    default         = "CURRENT_TIMESTAMP"
    classifications = [kolumn_classification.public]
  }

  column "updated_at" {
    type            = "TIMESTAMP"
    nullable        = false
    default         = "CURRENT_TIMESTAMP"
    classifications = [kolumn_classification.public]
  }

  metadata = {
    purpose = "user_management"
    domain  = "authentication"
  }
}

create "kolumn_data_object" "post_schema" {
  name        = "Standard Post Schema"
  description = "Post schema for content management"

  column "id" {
    type            = "BIGINT"
    nullable        = false
    primary_key     = true
    classifications = [kolumn_classification.identifier]
  }

  column "title" {
    type            = "VARCHAR(200)"
    nullable        = false
    classifications = [kolumn_classification.public]
  }

  column "content" {
    type            = "TEXT"
    nullable        = true
    classifications = [kolumn_classification.public]
  }

  column "author_id" {
    type            = "BIGINT"
    nullable        = false
    classifications = [kolumn_classification.public]
  }

  column "status" {
    type            = "VARCHAR(20)"
    nullable        = false
    default         = "draft"
    classifications = [kolumn_classification.public]
  }

  column "created_at" {
    type            = "TIMESTAMP"
    nullable        = false
    default         = "CURRENT_TIMESTAMP"
    classifications = [kolumn_classification.public]
  }

  column "updated_at" {
    type            = "TIMESTAMP"
    nullable        = false
    default         = "CURRENT_TIMESTAMP"
    classifications = [kolumn_classification.public]
  }

  metadata = {
    purpose = "content_management"
    domain  = "publishing"
  }
}

# Classification definitions
create "kolumn_classification" "pii" {
  name        = "PII"
  description = "Personally Identifiable Information"
  requirements = {
    encryption   = true
    audit_access = true
  }
}

create "kolumn_classification" "public" {
  name        = "Public"
  description = "Public information"
  requirements = {
    encryption = false
  }
}

create "kolumn_classification" "identifier" {
  name        = "Identifier"
  description = "Unique identifiers and keys"
  requirements = {
    indexed = true
  }
}

create "kolumn_classification" "sensitive" {
  name        = "Sensitive"
  description = "Sensitive information requiring protection"
  requirements = {
    encryption = true
    hashing    = true
  }
}

# ✅ CORRECT: Tables reference data objects with dynamic blocks
create "postgres_table" "users" {
  name = "users"

  # Pull columns from data object
  dynamic "column" {
    for_each = kolumn_data_object.user_schema.columns
    content {
      name        = column.value.name
      type        = column.value.type == "BIGINT" && column.value.primary_key ? "UUID" : column.value.type == "TIMESTAMP" ? "TIMESTAMP" : column.value.type
      nullable    = column.value.nullable
      primary_key = column.value.primary_key
      unique      = column.value.unique
      default     = column.value.type == "BIGINT" && column.value.primary_key ? "gen_random_uuid()" : column.value.type == "TIMESTAMP" ? "NOW()" : column.value.default
    }
  }

  # Add environment-specific configuration
  schema = var.environment == "prod" ? "public" : var.environment
}

create "postgres_table" "posts" {
  name = "posts"

  # Pull columns from data object
  dynamic "column" {
    for_each = kolumn_data_object.post_schema.columns
    content {
      name        = column.value.name
      type        = column.value.type == "BIGINT" && column.value.primary_key ? "UUID" : column.value.type == "BIGINT" ? "UUID" : column.value.type == "TIMESTAMP" ? "TIMESTAMP" : column.value.type
      nullable    = column.value.nullable
      primary_key = column.value.primary_key
      unique      = column.value.unique
      default     = column.value.type == "BIGINT" && column.value.primary_key ? "gen_random_uuid()" : column.value.type == "TIMESTAMP" ? "NOW()" : column.value.default
    }
  }

  schema = var.environment == "prod" ? "public" : var.environment
}

# Foreign key relationship
create "postgres_foreign_key" "posts_author_fk" {
  table              = postgres_table.posts
  columns            = ["author_id"]
  referenced_table   = postgres_table.users
  referenced_columns = ["id"]
  on_delete          = "CASCADE"
  on_update          = "CASCADE"
}

# Indexes for performance
create "postgres_index" "idx_users_email" {
  table   = postgres_table.users
  columns = ["email"]
  unique  = true
}

create "postgres_index" "idx_posts_author" {
  table   = postgres_table.posts
  columns = ["author_id"]
}

create "postgres_index" "idx_posts_status" {
  table   = postgres_table.posts
  columns = ["status"]
}

# Redis cache configuration
create "redis_key" "user_sessions" {
  pattern = "session:*"
  ttl     = 3600 # 1 hour
}

create "redis_key" "post_cache" {
  pattern = "post:*"
  ttl     = 300 # 5 minutes
}