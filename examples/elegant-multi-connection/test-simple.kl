# Simple test for multi-connection functionality

# ✅ CORRECT: Create data object FIRST for schema definition
create "kolumn_data_object" "user_schema" {
  name        = "Simple Test User Schema"
  description = "Basic user schema for multi-connection testing"

  columns = {
    id = {
      type            = "BIGINT"
      nullable        = false
      primary_key     = true
      classifications = [kolumn_classification.identifier]
    }

    email = {
      type            = "VARCHAR(255)"
      nullable        = false
      unique          = true
      classifications = [kolumn_classification.pii]
    }

    name = {
      type            = "VARCHAR(100)"
      nullable        = false
      classifications = [kolumn_classification.public]
    }
  }

  metadata = {
    purpose = "Simple testing"
    domain  = "test"
  }
}

# Classification definitions
create "kolumn_classification" "pii" {
  name        = "PII"
  description = "Personally Identifiable Information"
  requirements = {
    encryption   = true
    audit_access = true
  }
}

create "kolumn_classification" "public" {
  name        = "Public"
  description = "Public information"
  requirements = {
    encryption = false
  }
}

create "kolumn_classification" "identifier" {
  name        = "Identifier"
  description = "Unique identifiers and keys"
  requirements = {
    indexed = true
  }
}

# Enhanced Provider - Creates 4 connections automatically
provider "postgres" "multi" {
  # Pattern expansion: 2 regions × 2 environments = 4 connections
  connection_pattern = "app-{region}-{env}.company.com"
  regions            = ["us", "eu"]
  environments       = ["prod", "staging"]

  # Common configuration for all connections
  port     = 5432
  database = "demo"
  username = "postgres"
  password = "password"
}

# ✅ CORRECT: Table references data object directly
create "postgres_table" "users" {
  provider   = postgres.multi # Auto-scales to all connections
  depends_on = []

  name = "users"
  columns = transform_columns(kolumn_data_object.user_schema.columns, {
    id = { type = "BIGSERIAL" }
  })
}
